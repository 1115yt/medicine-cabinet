{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medicine-cabinet-catalog",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "replace-with-your-database-name",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "ratelimits": [
    { "name": "IP_RATE", "namespace_id": "00000001", "simple": { "limit": 60, "period": 60 } },
    { "name": "ENROLL_RATE", "namespace_id": "00000002", "simple": { "limit": 3, "period": 60 } },
    { "name": "WRITE_RATE", "namespace_id": "00000003", "simple": { "limit": 10, "period": 60 } }
  ],
  "vars": {
    "ENROLLMENT_ENABLED": "true",
    "WRITES_ENABLED": "true",
    "DAILY_CLIENT_LIMIT": "200",
    "DAILY_WRITE_LIMIT": "1000"
  }
}
